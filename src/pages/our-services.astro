---
import BaseLayout from '../layouts/BaseLayout.astro';
import { serviceGroups } from '../data/services';
---
<BaseLayout title="Hair Color, Blonding & Haircuts in Sumner, WA" description="Explore haircuts, dimensional color, blonding, extensions, and treatments at Hillary Faye Design in Sumner, WA.">
  <header class="page-hero"><p class="eyebrow">The menu</p><h1>Our services</h1></header>
  <div class="services section">
    <aside><p class="eyebrow">Browse</p>{serviceGroups.map((group) => <a href={`#${group.name.toLowerCase().replaceAll(' ','-').replaceAll('&','and')}`}>{group.name}</a>)}</aside>
    <div class="menus">
      {serviceGroups.map((group) => <section id={group.name.toLowerCase().replaceAll(' ','-').replaceAll('&','and')}><h2>{group.name}</h2><p class="note">All prices are starting points and subject to change.</p>{group.items.map(([name,price]) => <div class="service"><span>{name}</span><span class="dots"></span><strong>{price}</strong></div>)}</section>)}
    </div>
  </div>
  <section class="book"><p class="eyebrow">Your chair is waiting</p><h2>Let’s make something beautiful.</h2><a class="button button-light" href="#book-now">Book appointment</a></section>
</BaseLayout>
<style>
  .services{display:grid;grid-template-columns:250px 1fr;gap:clamp(3rem,8vw,9rem)}aside{position:sticky;top:2rem;align-self:start;display:flex;flex-direction:column;gap:.8rem}aside a{text-decoration:none;font-size:.9rem}.menus{max-width:800px}.menus section{padding:0 0 5rem;margin-bottom:5rem;border-bottom:1px solid var(--line);scroll-margin-top:2rem}.menus section:last-child{border:0;margin:0}.menus h2{font-size:clamp(2.2rem,4vw,4rem);margin-bottom:.5rem}.note{font-size:.8rem;opacity:.65;margin-bottom:2rem}.service{display:flex;align-items:baseline;gap:.6rem;padding:1rem 0}.dots{flex:1;border-bottom:1px dotted var(--line)}.service strong{font-weight:500}.book{background:var(--clay);color:white;text-align:center;padding:clamp(5rem,9vw,9rem) 1.5rem}.book h2{margin-bottom:2.5rem}@media(max-width:760px){.services{grid-template-columns:1fr}aside{display:none}.service{font-size:.88rem}}
</style>
