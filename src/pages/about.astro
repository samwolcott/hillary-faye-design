---
import BaseLayout from '../layouts/BaseLayout.astro';
import BookingLink from '../components/BookingLink.astro';
---
<BaseLayout title="About Our Sumner Hair Salon | Hillary Faye Design" description="Meet Hillary Faye Design, a Sumner, WA hair salon specializing in personal designer cuts and dimensional color since 2011.">
  <section class="story">
    <div class="story-copy">
      <p class="eyebrow">Our story</p>
      <h1>Beautiful hair, made personal.</h1>
      <p class="lede">Hillary Faye Design was founded in 2011 with one clear focus: providing personal designer cuts and beautiful dimensional color.</p>
    </div>
    <div class="video-frame" aria-labelledby="story-video-title">
      <h2 class="sr-only" id="story-video-title">The Hillary Faye Design story</h2>
      <iframe
        src="https://www.youtube-nocookie.com/embed/BgS1ZBLAG-c?rel=0"
        title="The Hillary Faye Design story"
        loading="lazy"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        referrerpolicy="strict-origin-when-cross-origin"
        allowfullscreen
      ></iframe>
    </div>
    <div class="story-footer">
      <p>Our studio is a warm, welcoming place to slow down, feel heard, and walk away with hair that fits your life. We pair craft and creativity with honest conversation, so every result feels unmistakably yours.</p>
      <BookingLink class="button button-light">Come see us</BookingLink>
    </div>
  </section>
  <section class="promise section"><p class="eyebrow">Our approach</p><div><h2>Listen closely.<br />Design thoughtfully.<br />Care deeply.</h2><p>Whether you’re refining your signature look or ready for a complete change, your appointment begins with what matters to you. The result is beautiful, wearable hair—and an experience worth looking forward to.</p></div></section>
</BaseLayout>
<style>
  .story{background:var(--ink);color:var(--white);padding:clamp(4rem,8vw,8rem) clamp(1.25rem,6vw,7rem) clamp(5rem,10vw,10rem)}.story-copy{text-align:center;max-width:1050px;margin:0 auto clamp(3rem,6vw,5rem)}.story-copy h1{font-size:clamp(4rem,8vw,8rem);margin-bottom:2.5rem}.story-copy .lede{max-width:850px;margin-inline:auto;font-size:clamp(1.35rem,2.5vw,2.25rem)}.video-frame{position:relative;aspect-ratio:16/9;max-width:1280px;margin-inline:auto;background:#111;overflow:hidden}.video-frame iframe{position:absolute;inset:0;width:100%;height:100%;border:0}.story-footer{max-width:1280px;margin:clamp(2rem,4vw,3.5rem) auto 0;display:flex;justify-content:space-between;align-items:center;gap:3rem}.story-footer p{max-width:720px;margin:0}.story-footer .button{flex:none}.promise{background:var(--cream)}.promise>div{display:grid;grid-template-columns:1.2fr .8fr;gap:5rem;align-items:end}.promise h2{margin:0}.promise p{max-width:500px;margin:0}@media(max-width:760px){.story-footer{align-items:flex-start;flex-direction:column;gap:2rem}.promise>div{grid-template-columns:1fr;gap:2rem}}
</style>
