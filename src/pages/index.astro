---
import BaseLayout from '../layouts/BaseLayout.astro';
import BookingLink from '../components/BookingLink.astro';
import SeasonalPromo from '../components/SeasonalPromo.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<BaseLayout>
  <section class="hero">
    <img src={`${base}/images/hero.webp`} srcset={`${base}/images/responsive/hero-640.webp 640w, ${base}/images/hero.webp 1024w`} sizes="100vw" width="1024" height="682" alt="Dimensional blonde hair styled at Hillary Faye Design" fetchpriority="high" />
    <div class="hero-copy"><p class="eyebrow">Sumner, Washington</p><h1>Hair, designed for you.</h1><BookingLink class="button button-light">Book your visit</BookingLink></div>
  </section>
  <section class="intro section">
    <p class="eyebrow">Welcome to Hillary Faye Design</p>
    <p class="lede">Personal designer cuts and beautiful dimensional color, thoughtfully created to feel like the very best version of you.</p>
  </section>
  <SeasonalPromo
    id="back-to-school-special"
    image={`${base}/images/back-to-school-special-v2.jpg`}
    mobileImage={`${base}/images/back-to-school-special-mobile.jpg`}
    imageAlt="Back to School Special: luxe partial with gloss, cut and style with Josie for $177, August 12 through September 12"
    eyebrow="Seasonal offer · August 12–September 12"
    heading="A fresh look for what’s next."
    buttonLabel="Book the $177 special"
    finePrint="Offer valid Aug 12–Sep 12 only with stylist Josie."
    expiresAt="2026-09-13T00:00:00-07:00"
  />
  <section class="split">
    <div class="split-image"><img src={`${base}/images/responsive/salon-900.webp`} srcset={`${base}/images/responsive/salon-480.webp 480w, ${base}/images/responsive/salon-900.webp 900w, ${base}/images/salon.webp 1169w`} sizes="(max-width: 760px) 100vw, 54vw" width="1169" height="1752" alt="Inside the Hillary Faye Design salon" loading="lazy" decoding="async" /></div>
    <div class="split-copy"><p class="eyebrow">A little luxury</p><h2>Come as you are. Leave glowing.</h2><p>We believe great hair starts with listening. Every appointment is personal, relaxed, and shaped around your style, your routine, and where you want to go next.</p><a href={`${base}/our-services`}>Explore our services →</a></div>
  </section>
  <section class="cta section"><p class="eyebrow">Ready when you are</p><h2>Make time for your hair.</h2><div><BookingLink class="button">Book now</BookingLink><a class="text-link" href="https://hairstory.com/?rfsn=8999226.20acf3" target="_blank" rel="noreferrer">Shop Hairstory products</a></div></section>
  <section class="policy"><p class="eyebrow">Reservation policy</p><p>Upon reservation, we collect a 50% deposit. If you need to cancel within 24 hours of your service, the deposit is non-refundable. Otherwise, we would be happy to apply it to a future reservation.</p></section>
</BaseLayout>
<style>
  .hero{height:calc(100svh - 116px);min-height:600px;position:relative;color:white;overflow:hidden}.hero:after{content:'';position:absolute;inset:0;background:linear-gradient(90deg,rgba(21,17,14,.58),rgba(21,17,14,.03) 75%)}.hero>img{width:100%;height:100%;object-fit:cover}.hero-copy{position:absolute;z-index:1;left:clamp(1.25rem,7vw,8rem);bottom:clamp(4rem,10vw,8rem);max-width:780px}.hero h1{margin:.25rem 0 2.5rem}.intro{text-align:center}.intro .lede{max-width:900px;margin:0 auto}.split{display:grid;grid-template-columns:1.08fr .92fr;min-height:720px;background:var(--cream)}.split-image img{width:100%;height:100%;object-fit:cover}.split-copy{align-self:center;padding:clamp(3rem,8vw,8rem)}.split-copy h2{margin-bottom:2rem}.split-copy p:not(.eyebrow){max-width:520px;margin-bottom:2rem}.cta{text-align:center}.cta h2{margin-bottom:2.5rem}.cta>div{display:flex;align-items:center;justify-content:center;gap:2rem;flex-wrap:wrap}.text-link{text-transform:uppercase;letter-spacing:.1em;font-size:.72rem}.policy{background:var(--clay);color:white;padding:3rem clamp(1.25rem,6vw,7rem);display:grid;grid-template-columns:1fr 3fr;gap:3rem}.policy p{margin:0;max-width:900px}@media(max-width:760px){.hero{height:72svh;min-height:560px}.split{grid-template-columns:1fr;min-height:0}.split-image{height:430px}.policy{grid-template-columns:1fr;gap:.5rem}}
</style>
