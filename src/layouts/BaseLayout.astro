---
import '../styles/global.css';
import BookingLink from '../components/BookingLink.astro';
interface Props { title?: string; description?: string; robots?: string; image?: string; }
const {
  title = 'Hair Salon in Sumner, WA | Hillary Faye Design',
  description = 'Personal designer haircuts and beautiful dimensional color at Hillary Faye Design in Sumner, Washington.',
  robots = 'index, follow',
  image = '/images/hero.webp',
} = Astro.props;
const currentPath = Astro.url.pathname;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const url = (path: string) => `${base}${path}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(url(image), Astro.site);
const businessSchema = {
  '@context': 'https://schema.org',
  '@type': 'HairSalon',
  '@id': new URL('/#hair-salon', Astro.site).href,
  name: 'Hillary Faye Design',
  url: new URL('/', Astro.site).href,
  logo: new URL(url('/images/logo.webp'), Astro.site).href,
  image: new URL(url('/images/hero.webp'), Astro.site).href,
  description: 'Personal designer haircuts and beautiful dimensional color in Sumner, Washington.',
  telephone: '+12539482111',
  email: 'info@hillaryfayedesign.com',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '816 Cherry Ave, Unit 4B',
    addressLocality: 'Sumner',
    addressRegion: 'WA',
    postalCode: '98390',
    addressCountry: 'US',
  },
  openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Thursday'], opens: '07:30', closes: '11:30' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Tuesday', 'Friday'], opens: '11:30', closes: '19:30' },
  ],
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: '+12532016481',
    contactType: 'text messaging',
  },
  sameAs: [
    'https://www.instagram.com/hillaryfayedesign/',
    'https://www.facebook.com/hillaryfayedesign/',
  ],
};
const nav = [
  ['/our-services', 'Our Services'],
  ['/about', 'Our Story'],
  ['/our-happy-guests', 'Our Happy Guests'],
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#f2eee7" />
    <link rel="icon" href={url('/favicon-32.png')} type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} sizes="180x180" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500&family=Italiana&display=swap" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Hillary Faye Design" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1024" />
    <meta property="og:image:height" content="682" />
    <meta property="og:image:alt" content="Dimensional blonde hair styled at Hillary Faye Design" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content="Dimensional blonde hair styled at Hillary Faye Design" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(businessSchema)}></script>
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="wordmark" href={url('/')} aria-label="Hillary Faye Design home">
        <img src={url('/images/responsive/logo-280.webp')} width="170" height="101" alt="Hillary Faye Design" decoding="async" />
      </a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Open navigation"><span></span><span></span><span></span></button>
      <nav id="site-nav" aria-label="Main navigation">
        {nav.map(([href, label]) => <a href={url(href)} aria-current={currentPath.endsWith(href) ? 'page' : undefined}>{label}</a>)}
        <BookingLink class="button button-small">Book appointment</BookingLink>
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer>
      <div class="footer-grid">
        <div><p class="eyebrow">Follow along</p><a href="https://www.instagram.com/hillaryfayedesign/" target="_blank" rel="noreferrer">Instagram</a><br /><a href="https://www.facebook.com/hillaryfayedesign/" target="_blank" rel="noreferrer">Facebook</a></div>
        <div><p class="eyebrow">Hours</p><p>Monday / Thursday<br />7:30am–11:30am</p><p>Tuesday / Friday<br />11:30am–7:30pm</p></div>
        <div><p class="eyebrow">Visit</p><p><a href="https://www.google.com/maps/search/?api=1&query=Hillary+Faye+Design%2C+816+Cherry+Ave+Unit+4B%2C+Sumner%2C+WA+98390" target="_blank" rel="noreferrer" aria-label="Open Hillary Faye Design in Google Maps">816 Cherry Ave, Unit 4B<br />Sumner, WA 98390</a></p><a href="mailto:info@hillaryfayedesign.com">info@hillaryfayedesign.com</a><br /><a href="tel:+12539482111">Call: (253) 948-2111</a><br /><a href="sms:+12532016481">Text: (253) 201-6481</a></div>
      </div>
      <div class="footer-bottom"><span>© {new Date().getFullYear()} Hillary Faye Design</span><a href={url('/privacy-policy')}>Privacy policy</a></div>
    </footer>
    <script is:inline>
      const button = document.querySelector('.menu-toggle');
      const nav = document.querySelector('#site-nav');
      const firstNavLink = nav?.querySelector('a');
      const closeMenu = (restoreFocus = false) => {
        button?.setAttribute('aria-expanded', 'false');
        button?.setAttribute('aria-label', 'Open navigation');
        nav?.classList.remove('open');
        if (restoreFocus) button?.focus();
      };
      button?.addEventListener('click', () => {
        const open = button.getAttribute('aria-expanded') === 'true';
        button.setAttribute('aria-expanded', String(!open));
        button.setAttribute('aria-label', open ? 'Open navigation' : 'Close navigation');
        nav?.classList.toggle('open', !open);
        if (!open) firstNavLink?.focus();
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && nav?.classList.contains('open')) closeMenu(true);
        if (event.key === 'Tab' && nav?.classList.contains('open')) {
          const navLinks = [...nav.querySelectorAll('a')];
          const lastNavLink = navLinks.at(-1);
          if (event.shiftKey && document.activeElement === button) {
            event.preventDefault();
            lastNavLink?.focus();
          } else if (!event.shiftKey && document.activeElement === lastNavLink) {
            event.preventDefault();
            button?.focus();
          }
        }
      });
      document.addEventListener('click', (event) => {
        if (!(event.target instanceof Element)) return;
        if (nav?.classList.contains('open') && !nav.contains(event.target) && !button?.contains(event.target)) closeMenu();
        if (event.target.closest('#site-nav a')) closeMenu();
      });
      window.addEventListener('resize', () => {
        if (window.innerWidth > 760) closeMenu();
      });

      let bookingPromise;
      const loadBooking = () => {
        if (window.blvd?.openBookingWidget) return Promise.resolve();
        if (bookingPromise) return bookingPromise;
        bookingPromise = new Promise((resolve, reject) => {
          const script = document.createElement('script');
          const timeout = window.setTimeout(() => reject(new Error('Booking overlay timed out')), 5000);
          script.src = 'https://static.joinboulevard.com/injector.min.js';
          script.async = true;
          script.onload = () => {
            try {
              window.blvd.init({ businessId: 'e2268497-1ec6-4515-8d8d-a0afd7dd6855' });
              window.clearTimeout(timeout);
              resolve();
            } catch (error) { reject(error); }
          };
          script.onerror = (error) => {
            window.clearTimeout(timeout);
            reject(error);
          };
          document.head.append(script);
        });
        return bookingPromise;
      };
      document.addEventListener('pointerover', (event) => {
        if (event.target instanceof Element && event.target.closest('[data-booking-link]')) loadBooking().catch(() => {});
      });
      document.addEventListener('focusin', (event) => {
        if (event.target instanceof Element && event.target.closest('[data-booking-link]')) loadBooking().catch(() => {});
      });

      document.addEventListener('click', async (event) => {
        if (!(event.target instanceof Element)) return;
        const bookingLink = event.target.closest('[data-booking-link]');
        if (!bookingLink || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        event.preventDefault();
        closeMenu();
        try {
          await loadBooking();
          if (!window.blvd?.openBookingWidget) throw new Error('Booking overlay unavailable');
          window.blvd.openBookingWidget();
        } catch {
          window.location.assign(bookingLink.href);
        }
      });
    </script>
  </body>
</html>
