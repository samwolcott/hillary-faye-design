---
import BookingLink from './BookingLink.astro';

interface Props {
  id: string;
  image: string;
  mobileImage?: string;
  imageWidth?: number;
  imageHeight?: number;
  artworkShape?: 'wide' | 'square';
  imageAlt: string;
  eyebrow: string;
  heading: string;
  buttonLabel: string;
  finePrint: string;
  startsAt?: string;
  expiresAt?: string;
  preview?: boolean;
}

const {
  id,
  image,
  mobileImage,
  imageWidth = 1984,
  imageHeight = 793,
  artworkShape = 'wide',
  imageAlt,
  eyebrow,
  heading,
  buttonLabel,
  finePrint,
  startsAt = null,
  expiresAt = null,
  preview = false,
} = Astro.props;
---

<section class:list={['promo-ad', artworkShape]} id={id} aria-labelledby={`${id}-title`} hidden={Boolean(startsAt) && !preview}>
  <div class="promo-ad-copy">
    <p class="eyebrow">{eyebrow}</p>
    <h2 id={`${id}-title`}>{heading}</h2>
    <div class="promo-ad-action">
      <BookingLink class="button">{buttonLabel}</BookingLink>
      <p>{finePrint}</p>
    </div>
  </div>
  <picture>
    {mobileImage && <source media="(max-width: 760px)" srcset={mobileImage} />}
    <img src={image} width={imageWidth} height={imageHeight} alt={imageAlt} loading="lazy" decoding="async" />
  </picture>
</section>

<script is:inline define:vars={{ id, startsAt, expiresAt, preview }}>
  const promo = document.getElementById(id);
  const startTime = startsAt ? new Date(startsAt).getTime() : null;
  const endTime = expiresAt ? new Date(expiresAt).getTime() : null;

  const syncPromo = () => {
    if (!promo) return;
    const now = Date.now();
    const hasStarted = startTime === null || now >= startTime;
    const hasEnded = endTime !== null && now >= endTime;
    promo.hidden = !(preview || (hasStarted && !hasEnded));

    if (preview) return;
    const nextBoundary = [startTime, endTime].find((time) => time !== null && time > now);
    if (nextBoundary) window.setTimeout(syncPromo, Math.min(nextBoundary - now + 50, 2147483647));
  };

  syncPromo();
</script>

<style>
  .promo-ad {
    margin: 0 clamp(1.25rem, 4vw, 4.5rem) clamp(5rem, 10vw, 10rem);
    background: var(--white);
    border: 1px solid var(--line);
    box-shadow: 0 24px 70px rgba(36, 35, 31, .08);
  }

  .promo-ad picture,
  .promo-ad img {
    display: block;
    width: 100%;
  }

  .promo-ad img {
    height: auto;
  }

  .promo-ad.square picture {
    max-width: 760px;
    margin-inline: auto;
    border-top: 1px solid var(--line);
  }

  .promo-ad-copy {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: clamp(1.5rem, 3vw, 2.5rem);
  }

  .promo-ad-copy .eyebrow {
    margin: 0;
    color: #08706d;
  }

  .promo-ad-copy h2 {
    max-width: 560px;
    margin: 0 auto 0 0;
    font-size: clamp(1.75rem, 3vw, 3rem);
  }

  .promo-ad-action {
    flex: 0 0 auto;
    text-align: center;
  }

  .promo-ad-action :global(.button) {
    flex: 0 0 auto;
  }

  .promo-ad-action p {
    max-width: 230px;
    margin: .65rem auto 0;
    color: rgba(36, 35, 31, .7);
    font-size: .65rem;
    line-height: 1.45;
  }

  @media (max-width: 760px) {
    .promo-ad {
      margin-bottom: 5rem;
      display: flex;
      flex-direction: column-reverse;
    }

    .promo-ad-copy {
      align-items: stretch;
      flex-direction: column;
      gap: 1.25rem;
    }

    .promo-ad-copy h2 {
      margin: 0;
    }

    .promo-ad-action,
    .promo-ad-action :global(.button) {
      width: 100%;
    }
  }
</style>
